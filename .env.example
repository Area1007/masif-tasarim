# Sitenin yayındaki tam adresi (sonunda / olmadan).
# Sitemap, robots.txt, canonical ve Open Graph bağlantılarında kullanılır.
# Vercel'de: Project Settings → Environment Variables
NEXT_PUBLIC_SITE_URL=https://www.ornek-alanadi.com

# Sanity CMS bağlantısı (gizli bilgi değildir; dataset public)
NEXT_PUBLIC_SANITY_PROJECT_ID=ssg8wqv9
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Sanity webhook imza anahtarı — GİZLİDİR, repoya gerçek değer yazmayın.
# Sanity'deki webhook "Secret" alanıyla birebir aynı olmalı.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SANITY_REVALIDATE_SECRET=
